litellm_settings:
  # Anthropic prompt caching: 0.1x reads vs 1.25x writes. Injects breakpoints on
  # the system tail and the trailing turn, and on the tool block (which sits at
  # the very front of the prefix, so caching it protects everything behind it).
  enable_anthropic_prompt_caching: true
  anthropic_prompt_caching_ttl: "1h"
  cache_control_injection_points:
    - location: "tool_config"
    - location: "message"
      role: "system"
  # Drops `thinking` when thinking_blocks are missing from history, instead of
  # letting Anthropic 400 the request.
  modify_params: true
  # Built-in compression_interception is replaced by claude_aware_compression.
  # The built-in version injects litellm_content_retrieve which breaks Claude Code.
  # Tune with env vars: CLAUDE_COMPRESSION_TRIGGER, CLAUDE_COMPRESSION_TARGET,
  # CLAUDE_COMPRESSION_MAX_TOOL_RESULT_CHARS, CLAUDE_COMPRESSION_MIN_RECENT_MESSAGES.
  compression_interception_params:
    enabled: false
  require_auth_for_metrics_endpoint: false
  drop_unsupported_params: true
  cache: true
  cache_params:
    type: redis
    host: redis
    port: 6379
    ttl: 3600
  success_callback: ["sqlite"]
  failure_callback: ["sqlite"]
  store_audit_logs: true
  # Keep spend tracking enabled without blocking local smoke/matrix tests.
  # LiteLLM treats 0 as a hard zero-dollar budget, not "unlimited".
  max_budget: 1000000
  budget_duration: 7d
  # LiteLLM resolves callback modules relative to /app when loading config.
  # claude_aware_compression compresses Anthropic Messages without injecting
  # a foreign tool, so Claude Code stays coherent.
  callbacks: [ prometheus, claude_aware_compression.claude_aware_compression, ccproxy_callback.ccproxy_handler ]

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  database_connection_pool_limit: 10
  store_model_in_db: false
  store_prompts_in_spend_logs: true
  ui_access_mode: "username_password"
