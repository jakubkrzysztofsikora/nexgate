  # Auto Router v2 (LiteLLM >= 1.94.x, released 2026-07-14).
  # Heuristic scorer + keyword rules + session affinity + cache injection.
  # Call it by requesting model "smart-router" (cheap mix) or
  # "smart-router-claude" (Claude-tiered mix).
  - model_name: smart-router
    litellm_params:
      model: auto_router/complexity_router
      drop_params: true
      # Auto-injects Anthropic prompt caching on every tier that supports it.
      # Claude Code sends huge static prefixes (CLAUDE.md + tool defs) every
      # turn; cache reads cost 0.1× base input on Opus/Sonnet/Haiku.
      # 3 breakpoints (Anthropic caps at 4/request): tool_config + system
      # pin the largest, most stable prefix so it survives a trailing-turn
      # cache bust (compression drop, terse-directive first-use) instead of
      # both getting swept into that turn's uncached rewrite.
      cache_control_injection_points:
        - location: tool_config
        - location: message
          role: system
        - location: message
          index: -1
      complexity_router_config:
        tiers:
          # SIMPLE points at OpenRouter free tier so the router stays usable
          # even when local llama.cpp is down. Free providers cost ~$0.
          SIMPLE: or/gpt-oss-20b-free
          MEDIUM: kimi-k3
          COMPLEX: glm-5.2
          REASONING: claude-opus-5[1m]
        # Pin a session to its first-turn tier so the Anthropic cache stays
        # warm across the whole conversation. Without this, a follow-up
        # "thanks!" would reclassify into a different model and bust the cache.
        session_affinity: true
        session_affinity_ttl_seconds: 3600
        keyword_tier_rules:
          - keywords: ["hi", "hello", "thanks", "ok"]
            tier: SIMPLE
          - keywords: ["refactor", "architect", "implement", "design"]
            tier: REASONING
        custom_technical_keywords: [kafka, redis, postgresql, udp, dns]
      complexity_router_default_model: kimi-k3

  - model_name: smart-router-claude
    litellm_params:
      model: auto_router/complexity_router
      drop_params: true
      # 3 breakpoints (Anthropic caps at 4/request): tool_config + system
      # pin the largest, most stable prefix so it survives a trailing-turn
      # cache bust (compression drop, terse-directive first-use) instead of
      # both getting swept into that turn's uncached rewrite.
      cache_control_injection_points:
        - location: tool_config
        - location: message
          role: system
        - location: message
          index: -1
      complexity_router_config:
        tiers:
          SIMPLE: [qwencloud/deepseek-v4-flash, or/gpt-oss-20b-free, claude-haiku-4-5-20251001]
          MEDIUM: [glm-5.1, kimi, claude-sonnet-5]
          # Cross-provider pools spread load across subscriptions/free tiers.
          # session_affinity pins one pick per session (cache stays warm);
          # different sessions land on different pool members.
          # COMPLEX = coding/architecting workhorses. REASONING = hardest stuff.
          COMPLEX: [claude-opus-5, glm-5.2, claude-opus-4-8, chatgpt/gpt-5.6-terra, deepseek-v4-pro]
          REASONING: [claude-fable-5-1, chatgpt/gpt-5.6-sol, kimi-k3, qwencloud/qwen3.8-max]
        session_affinity: true
        session_affinity_ttl_seconds: 3600
        keyword_tier_rules:
          - keywords: ["hi", "hello", "thanks", "ok"]
            tier: SIMPLE
          - keywords: ["refactor", "architect", "implement", "design"]
            tier: COMPLEX
      complexity_router_default_model: claude-sonnet-5

