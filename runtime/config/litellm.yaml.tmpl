# Portable NexGate LiteLLM configuration.
# Every provider is disabled until its required environment variables are supplied.
# LiteLLM proxy config — template
# Rendered by start-local.sh into config/litellm.yaml.

router_settings:
  enable_pre_call_checks: true
  disable_cooldowns: true
  # Abort streams that return HTTP 200 but do not emit a first chunk so the
  # router can try configured fallbacks instead of leaving Claude Code stuck.
  stream_timeout: 60
  # Hard-enforce per-model rpm/tpm (otherwise they are only routing hints).
  # Required so claude-chat rpm/tpm convert upstream 429s into local
  # backpressure before the request ever leaves LiteLLM.
  #optional_pre_call_checks:
  #  - enforce_model_rate_limits
  default_fallbacks: ["scaleway/gpt-oss", "minimax-m3", "mistral", "glm-5.2"]
  context_window_fallbacks:
    - {"bielik": []}
    - {"psyllm-4b": []}
    - {"glm-5.1": []}
    - {"glm-5.2": ["qwencloud/glm-5.2", "scaleway/gpt-oss", "minimax-m3"]}
    - {"glm-5.3": ["glm-5.3-flash", "glm-5.2", "qwencloud/glm-5.2", "scaleway/gpt-oss", "minimax-m3"]}
    - {"glm-5.3-flash": ["glm-5.3", "glm-5.2", "qwencloud/glm-5.2", "scaleway/gpt-oss", "minimax-m3"]}
    - {"qwencloud/glm-5.2": ["scaleway/gpt-oss", "minimax-m3", "mistral"]}
    - {"kimi": ["scaleway/gpt-oss", "mistral", "minimax-m3"]}
    - {"mistral": ["scaleway/gpt-oss", "minimax-m3", "glm-5.2"]}
    - {"minimax-m3": ["scaleway/gpt-oss", "mistral", "glm-5.2"]}
    - {"claude-opus-4-8": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-opus-4-8[1m]": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-opus-4-7": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-opus-4-7[1m]": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-opus-5": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-opus-5[1m]": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss", "glm-5.2"]}
    - {"claude-sonnet-5[1m]": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"claude-sonnet-5": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"claude-fable-5-1": ["minimax-m3", "scaleway/gpt-oss", "chatgpt/gpt-5.6-sol"]}
    - {"opus[1m]": ["chatgpt/gpt-5.6-terra", "claude-opus-4-8[1m]", "minimax-m3", "scaleway/gpt-oss"]}
    - {"claude-haiku-4-5-20251001": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    # Odysseus GPT/native-tool streams should not fall through DeepSeek: a
    # DeepSeek read timeout after streaming headers can leave chat clients with
    # a silent 200 stream. Keep DeepSeek directly selectable and as a Claude
    # fallback; use Kimi only for this ChatGPT subscription route.
    - {"chatgpt/gpt-5.6-sol":["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"chatgpt/gpt-5.6-terra": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"deepseek-v4-pro[1m]": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"qwencloud/qwen3.7-plus": ["minimax-m3", "deepseek-v4-pro[1m]", "glm-5.2", "scaleway/gpt-oss"]}
    - {"qwencloud/qwen3.8-max": ["qwencloud-payg/qwen3.7-max-preview", "qwen3.7-max-2026-06-08", "minimax-m3", "deepseek-v4-pro[1m]", "glm-5.2", "scaleway/gpt-oss"]}
    - {"qwencloud/deepseek-v4-flash": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"qwencloud/deepseek-v4-pro": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"circit-gateway": []}
  fallbacks:
    # Keep Cato-blocked providers such as Mistral and Z.ai/GLM out of
    # automatic rescue paths. They remain directly selectable below.
    # QwenCloud is international (Aliyun intl) and not subject to Cato,
    # so its models are safe in automatic rescue paths.
    - {"opus[1m]": ["chatgpt/gpt-5.6-terra", "minimax-m3", "scaleway/gpt-oss"]}
    - {"deepseek-v4-pro[1m]": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"bielik": ["scaleway-devstral", "mistral"]}
    - {"psyllm-4b": []}
    - {"gemma": ["minimax-m3", "scaleway/gpt-oss"]}
    - {"glm-5.2": ["qwencloud/glm-5.2", "qwencloud-payg/glm-5.2","qwencloud-payg/glm-5.1", "minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"glm-5.3": ["glm-5.3-flash", "glm-5.2", "qwencloud/glm-5.2", "qwencloud-payg/glm-5.2", "minimax-m3", "scaleway/gpt-oss"]}
    - {"glm-5.3-flash": ["glm-5.3", "glm-5.2", "qwencloud/glm-5.2", "qwencloud-payg/glm-5.2", "minimax-m3", "scaleway/gpt-oss"]}
    - {"kimi": ["minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"mistral": ["minimax-m3", "scaleway/gpt-oss"]}
    - {"minimax-m3": ["mistral", "scaleway/gpt-oss"]}
    - {"claude-opus-4-8": ["qwencloud/qwen3.8-max", "chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-opus-4-8[1m]": ["qwencloud/qwen3.8-max", "chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-opus-4-7": ["qwencloud/qwen3.8-max", "chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-opus-4-7[1m]": ["qwencloud/qwen3.8-max", "chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-opus-5": ["chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-opus-5[1m]": ["chatgpt/gpt-5.6-terra", "minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"claude-sonnet-5[1m]": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss", "mistral"]}
    - {"claude-sonnet-5": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss", "mistral"]}
    - {"claude-fable-5-1": ["qwencloud/qwen3.8-max", "minimax-m3", "scaleway/gpt-oss"]}
    - {"claude-haiku-4-5-20251001": ["qwencloud/deepseek-v4-flash", "minimax-m3", "scaleway/gpt-oss", "mistral"]}
    - {"qwencloud/qwen3.7-plus": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"qwencloud/qwen3.8-max": ["qwencloud-payg/qwen3.7-max-preview", "qwen3.7-max-2026-06-08", "minimax-m3", "deepseek-v4-pro[1m]", "glm-5.2", "scaleway/gpt-oss"]}
    - {"qwencloud/deepseek-v4-flash": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    - {"qwencloud/deepseek-v4-pro": ["minimax-m3", "deepseek-v4-pro[1m]", "scaleway/gpt-oss"]}
    # Keep ChatGPT tool-stream fallback away from DeepSeek timeout stalls.
    - {"chatgpt/gpt-5.6-terra": ["scaleway/gpt-oss", "minimax-m3"]}
    - {"circit-gateway": []}
    - {"*": ["scaleway/gpt-oss", "minimax-m3", "mistral"]}

model_list:
  # QwenCloud (DashScope International OpenAI-compatible endpoint).
  # Models registered as <qwencloud/<name>> so chinol/opencode can address them
  # by namespace, mirroring the scaleway/<name> pattern.
  - model_name: qwencloud/qwen3.8-max
    litellm_params:
      model: openai/qwen3.8-max
      api_base: os.environ/NEXGATE_QWENCLOUD_QWEN3_8_MAX_API_BASE
      api_key: os.environ/QWENCLOUD_API_KEY
      parse_tool_call_from_content: true
      drop_params: true
      additional_drop_params: ["web_search_options"]
      allowed_openai_params: ["tools", "tool_choice", "parallel_tool_calls"]
      extra_body:
        enable_thinking: false
      max_tokens: 32000
      timeout: 60
      num_retries: 2
    model_info:
      context_window: 262144
      supports_function_calling: true
      supports_tool_choice: true
      supports_parallel_function_calling: true
      disable_background_health_check: true

