# ── Optional: host-managed local Bielik (llama.cpp) ──────────────
# Consumed by scripts/local-bielik.sh, which `make up` runs before the stack.
# The whole block is inert until NEXGATE_BIELIK_API_BASE above points at a real
# endpoint; leave it commented to keep local model serving switched off.
# BIELIK_SERVER_HOST=127.0.0.1
# BIELIK_SERVER_PORT=8082
# BIELIK_CONTEXT_LENGTH=32768
# BIELIK_REPO=speakleash/Bielik-11B-v2.3-Instruct-GGUF
# BIELIK_MODEL_FILE=Bielik-11B-v2.3-Instruct-Q4_K_M.gguf
# Set to 1 when launchd/systemd already supervises llama-server; the script
# then only health-checks it instead of downloading or starting anything.
# BIELIK_LAUNCHD_MANAGED=0
# LLAMA_CACHE_DIR=/path/to/gguf/cache
# LLAMA_SERVER_BIN=llama-server
# HF_TOKEN=replace-with-your-api-key
